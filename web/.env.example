# 前端設定範本。複製成 `web/.env` 後填值:
#
#     cp web/.env.example web/.env
#
# 什麼時候需要手動填?
#   - 只有「在本機跑 `npm run dev:web`」需要。
#   - 正式部署不需要:`npm run deploy:latest` 會從已部署 stack 的 CloudFormation
#     Outputs 自動產生 web/.env,任何一個值缺少就中止,不會部署沒有設定的前端。
#
# 值要去哪裡拿?部署完成後查這兩個 stack 的 Outputs:
#   aws cloudformation describe-stacks --stack-name <foundation stack> --query "Stacks[0].Outputs"
#   aws cloudformation describe-stacks --stack-name <control-plane stack> --query "Stacks[0].Outputs"
#
# web/.env 不進版控(見 .gitignore),這份範本只列欄位名稱,不含任何實際值。

# Cognito 所在區域,例如 ap-northeast-1
VITE_COGNITO_REGION=

# Foundation stack 的 Output:AuthUserPoolId
VITE_COGNITO_USER_POOL_ID=

# Foundation stack 的 Output:AuthUserPoolClientId
VITE_COGNITO_CLIENT_ID=

# Control-plane stack 的 Output:ApiUrl(HTTPS,結尾不加斜線)
VITE_API_URL=

# Control-plane stack 的 Output:WsUrl(WebSocket,wss://)
VITE_WS_URL=
