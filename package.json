{
  "name": "playagent-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless AI QA Platform",
  "workspaces": [
    "web",
    "infra",
    "worker"
  ],
  "scripts": {
    "build:web": "npm run build --workspace web",
    "dev:web": "npm run dev --workspace web",
    "test:web": "npm run test --workspace web",
    "synth": "npm run synth --workspace infra",
    "test:infra": "npm run test --workspace infra",
    "test:worker": "npm run test --workspace worker",
    "deploy:latest": "node scripts/deploy-latest.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
