# Device Farm 探索 runner 容器(跑在 ECS Fargate)。
# 用 Appium(webdriverio)驅動 Device Farm 真機,跑 screenshot→VLM→act 迴圈。
# 不需 Android SDK/adb——Device Farm 提供的是遠端 Appium(WebDriver)端點,純 HTTP。
FROM public.ecr.aws/docker/library/node:22-slim

WORKDIR /app

# ImageMagick:座標校正三件套(網格疊圖 / 亮鈕吸附 / 落點標記)用 `convert`/`identify`。
# 提升 VLM 在真機截圖上的點擊精度(Cocos2d-x/Unity 遊戲整張畫布無原生元素,VLM 易估偏)。
# imagemagick + 一組基本字型(fonts-dejavu-core):IM 的 -annotate 需要字型,否則會 Abort。
# imagemagick + 字型:座標校正三件套用。
# unzip:偵測 XAPK(列 ZIP 內容找 .apk)。
# default-jre-headless:跑 APKEditor.jar 合併 XAPK/split → universal APK(Device Farm 只吃單一 APK)。
# ffmpeg:分析整場錄影的音量時間軸(mediaAudio.mjs)。
# aapt / zipalign / apksigner:合併後先驗證 manifest/resources,再對齊、測試簽章與驗證。
# 新增的 Android 工具釘 Debian bookworm 版本,避免建置漂移。
RUN apt-get update \
  && apt-get install -y --no-install-recommends imagemagick fonts-dejavu-core unzip default-jre-headless curl ffmpeg \
     aapt=1:10.0.0+r36-10 apksigner=31.0.2-1 zipalign=1:10.0.0+r36-1 \
  && rm -rf /var/lib/apt/lists/*

# APKEditor:把 XAPK / split APK 合併成單一 universal APK。釘版本與 SHA-256 以求可重現建置。
# 1.4.9 官方 release 含 split merge issue 修正;輸出再由 aapt/zipalign/apksigner 驗證。
ARG APKEDITOR_VERSION=1.4.9
ARG APKEDITOR_SHA256=a9cd40df818845456be6d696de6110c89edf4b0a0580cb83438ed6b25a366e67
RUN mkdir -p /opt/apkeditor \
  && curl -fsSL -o /opt/apkeditor/APKEditor.jar \
     "https://github.com/REAndroid/APKEditor/releases/download/V${APKEDITOR_VERSION}/APKEditor-${APKEDITOR_VERSION}.jar" \
  && echo "${APKEDITOR_SHA256}  /opt/apkeditor/APKEditor.jar" | sha256sum -c - \
  && mkdir -p /opt/playagent \
  && keytool -genkeypair -noprompt -keystore /opt/playagent/android-debug.keystore \
     -storepass android -keypass android -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
     -dname "CN=PlayAgent Test,O=PlayAgent,C=US"

# 只裝執行相依(webdriverio + aws-sdk)。用容器專用 package.json。
COPY exploration-runner.package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

# 複製 runner 與其模組。
COPY explorationRunner.mjs appiumClient.mjs deviceFarmRefresh.mjs deviceFarmSetup.mjs imageTools.mjs apkMerge.mjs uitarsClient.mjs secretsResolver.mjs evidenceProtocol.mjs memoryGraph.mjs operatorMemory.mjs memoryTrace.mjs perfMonitor.mjs liveVideo.mjs mediaAudio.mjs moveFeedback.mjs deviceLogs.mjs agentTeam.mjs obsGuard.mjs adbClient.mjs windowsClient.mjs spinWatch.mjs converseShape.mjs tokenUsage.mjs scriptTracker.mjs reflex.mjs ./

# 環境變數由 ECS RunTask 的 containerOverrides 注入(PA_APPIUM_URL / PA_JOB / ...)。
CMD ["node", "explorationRunner.mjs"]
